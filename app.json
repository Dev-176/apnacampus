{
  "expo": {
    "name": "ApnaCampus",
    "slug": "apnacampus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "apnacampus",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#005F60"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.apnacampus.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#005F60"
      },
      "package": "com.apnacampus.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
